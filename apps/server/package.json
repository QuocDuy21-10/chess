{
  "name": "@chess/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./app": "./src/app.ts",
    "./test-db": "./src/test-db.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@chess/shared": "*",
    "@sentry/node": "^11.12.0",
    "arctic": "^3.7.0",
    "chess.js": "^1.4.0",
    "cookie": "^2.0.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "socket.io-client": "^4.8.4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.1.0"
  }
}
