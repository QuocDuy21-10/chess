# Copy to .env (ignored by git). `npm run dev` and the tests read it.
DATABASE_URL=postgres://chess:chess@localhost:5432/chess
TEST_DATABASE_URL=postgres://chess:chess@localhost:5432/chess_test

# At least one OAuth app. Register each with the callback URL http://localhost:3001/auth/<provider>/callback
# (see the README). Leave a pair blank to turn that provider off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production only: PUBLIC_URL=https://api.chess.example.com and CLIENT_ORIGIN=https://chess.example.com
